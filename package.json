    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
